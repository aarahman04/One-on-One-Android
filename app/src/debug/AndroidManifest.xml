<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: a second launcher icon that opens the scripted demo chat (no backend, no sign-in). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name=".DemoChatActivity" android:exported="true" android:label="1on1 Demo"
            android:theme="@style/Theme.OneOnOne" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Store captures use the same chat UI with fictional, conversational sample messages. -->
        <activity-alias android:name=".StoreDemoActivity" android:targetActivity=".DemoChatActivity"
            android:exported="true" android:label="One on One" />
        <activity-alias android:name=".StoreLetterActivity" android:targetActivity=".DemoChatActivity"
            android:exported="true" android:label="One on One" />
        <activity-alias android:name=".StoreCheckinActivity" android:targetActivity=".DemoChatActivity"
            android:exported="true" android:label="One on One" />
        <activity-alias android:name=".StoreChoicesActivity" android:targetActivity=".DemoChatActivity"
            android:exported="true" android:label="One on One" />
        <activity-alias android:name=".StoreCountdownActivity" android:targetActivity=".DemoChatActivity"
            android:exported="true" android:label="One on One" />
        <activity-alias android:name=".StoreStickersActivity" android:targetActivity=".DemoChatActivity"
            android:exported="true" android:label="One on One" />
        <activity android:name=".StoreCallActivity" android:exported="true" android:label="One on One"
            android:theme="@style/Theme.OneOnOne" />
    </application>
</manifest>
